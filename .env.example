# GitHub Integration Configuration
# Set your GitHub username here. Defaults to 'sahithi-manda' if not set.
VITE_GITHUB_USERNAME=sahithi-manda

# Optional: GitHub Personal Access Token (classic with public_repo or fine-grained read-only)
# Increases GitHub API rate limit from 60 requests/hour to 5,000 requests/hour.
# NEVER commit actual personal access tokens to version control.
VITE_GITHUB_TOKEN=
